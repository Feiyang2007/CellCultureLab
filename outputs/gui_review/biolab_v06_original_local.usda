            over "Reservoir"
            {
            }
        }
    }
}

def Camera "GuiReviewCamera"
{
    float2 clippingRange = (0.01, 100)
    float focalLength = 24
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -5.412656412791225)
    matrix4d xformOp:transform = ( (0.7452413135250994, -0.6667948594698256, -2.775557561562892e-17, 0), (0.26415433315211206, 0.2952313135229488, 0.9181835109565394, 0), (-0.6122400451557768, -0.6842682857623388, 0.39615532333609094, 0), (-3.2700458819612788, -3.4712064097355384, 2.6032665404091055, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0"
            {
                rel camera = </GuiReviewCamera>
                bool omni:rtx:rt:ecoMode:enabled
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1280, 720)
            }
        }
    }
}

