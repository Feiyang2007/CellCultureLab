def "GuiReview"
{
    def Material "White"
    {
        token outputs:surface.connect = </GuiReview/White/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.64, 0.68, 0.72)
            float inputs:roughness = 0.65
            token outputs:surface
        }
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 900
    }
}

over "Render" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </GuiReview/White> (
        bindMaterialAs = "strongerThanDescendants"
    )
}

over "physicsScene" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </GuiReview/White> (
        bindMaterialAs = "strongerThanDescendants"
    )
}

