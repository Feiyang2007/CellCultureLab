#usda 1.0
(
    metersPerUnit = 1
    subLayers = [
        @biolab_main_v07.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Environment"
    {
        over "Lab_021"
        {
            over "TableTopCollision_Physics" (
                prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:role"]
            )
            {
                custom string celllab:cn_label = "实验台面"
                token[] semantics:labels:class = ["bench_surface"]
                token[] semantics:labels:role = ["receptacle"]
            }
        }
    }

    over "TaskArea"
