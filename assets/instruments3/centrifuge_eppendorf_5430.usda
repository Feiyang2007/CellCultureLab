            rel physics:body0 = </Instrument/Bodies/body>
            rel physics:body1 = </Instrument/Bodies/lid>
            custom point3f physics:localPos0 = (0.1699992, 0.19833241, 0.22059418)
            custom point3f physics:localPos1 = (0.1699992, 0.19833241, 0.22059418)
            custom float physics:lowerLimit = -98.72063
            custom float physics:upperLimit = 0
        }

        def RevoluteJoint "body_rotor"
        {
            custom token physics:axis = "Z"
            rel physics:body0 = </Instrument/Bodies/body>
            rel physics:body1 = </Instrument/Bodies/rotor>
